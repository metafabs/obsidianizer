# Copy this file to .env and replace the placeholder below
# with the absolute path to your own Obsidian vault.
#
# Never commit your real .env file.
# Keep personal paths, API keys, persona files, memory files,
# credentials, and other machine-specific/private information
# in ignored local configuration files.

VAULT_PATH=/path/to/your/obsidian-vault

EMBED_MODEL=qwen3-embedding:4b
CHAT_MODEL=gemma4:12b-mlx
